{
  "manifest_version": 2,
  "name": "All-Site Media Downloader",
  "version": "1.0.0",
  "description": "Download images and videos from any website with progress tracking and previews",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "downloads",
    "notifications",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-48.png",
      "32": "icons/icon-48.png"
    },
    "default_title": "Media Downloader Settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "media-downloader@example.com",
      "strict_min_version": "57.0"
    }
  }
}
