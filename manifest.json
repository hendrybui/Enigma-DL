{
  "manifest_version": 3,
  "name": "Ultimate All-Site Image & Video Downloader",
  "version": "1.0.0",
  "description": "Download images, videos, audio files, and documents from any webpage with ease",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Ultimate Downloader"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Open the downloader popup"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ultimate-downloader@example.com",
      "strict_min_version": "128.0"
    }
  }
}
