{
  "name": "ultimate-all-site-image-video-downloader",
  "version": "1.0.0",
  "description": "Browser extension for downloading images, videos, audio files, and documents from any website",
  "scripts": {
    "lint": "eslint '**/*.js' --ignore-pattern 'node_modules/' --ignore-pattern 'web-ext-artifacts/'",
    "lint:fix": "eslint '**/*.js' --fix --ignore-pattern 'node_modules/' --ignore-pattern 'web-ext-artifacts/'",
    "build": "web-ext build --overwrite-dest",
    "run": "web-ext run",
    "start": "web-ext run",
    "generate-icons": "node scripts/create-placeholder-icons.js"
  },
  "keywords": [
    "browser-extension",
    "chrome",
    "firefox",
    "edge",
    "media-downloader",
    "image-downloader",
    "video-downloader",
    "audio-downloader"
  ],
  "author": "Hendry Bui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hendrybui/Enigma-DL.git"
  },
  "homepage": "https://github.com/hendrybui/Enigma-DL#readme",
  "devDependencies": {
    "web-ext": "^8.3.0",
    "eslint": "^8.0.0",
    "eslint-env": "webextensions"
  }
}
